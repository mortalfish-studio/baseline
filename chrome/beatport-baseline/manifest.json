{
  "manifest_version": 3,
  "name": "Baseline for Beatport",
  "version": "1.12.2",
  "description": "Lets the Baseline panel drive Beatport, YouTube Music and Apple Music: switch charts, playlists and artists in place, start them playing, list your playlists, add tracks to <3, and keep one thing playing at a time.",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.beatport.com/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://music.apple.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.beatport.com/*"
      ],
      "js": [
        "autoplay.js",
        "report.js",
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
