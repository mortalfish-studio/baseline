#!/usr/bin/env python3
"""afterlight: Baseline's command. The code is in afterlight.py beside this
launcher, imported rather than run, so Python keeps it compiled (in
bin/__pycache__) and each call starts in a few milliseconds instead of
recompiling seven thousand lines."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import afterlight  # noqa: E402  (bin/afterlight.py)

afterlight.main(sys.argv[1:])
