    {"name": "Nu Disco", "path": "genre/nu-disco-disco/50/top-100", "say": ["new disco", "disco", "nudisco"]},
    {"name": "Deep House", "path": "genre/deep-house/12/top-100", "say": ["deep"]},
    {"name": "Tech House", "path": "genre/tech-house/11/top-100", "say": ["tech"]},
